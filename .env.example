# Non-secret local defaults. Put real secrets in a local .env file only.
LOG_LEVEL=info
POLL_INTERVAL_MS=2000
JOB_LEASE_SECONDS=60

# Required per service; use separate database roles in production.
DATABASE_URL=postgresql://factory_role:change-me@localhost:5432/ai_product_factory

# Innovation-Man and Sales-Man only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=change-me
LLM_MODEL=change-me

# Manager-Man only.
GITHUB_TOKEN=change-me
DEEPSEEK_API_KEY=change-me
GITHUB_PIPELINE_REPOSITORY=empty-produkt
GITHUB_PIPELINE_BRANCH=main
GITHUB_PRODUCT_REPOSITORIES_PRIVATE=true
GITHUB_OWNER=GurkeSchaleSammler
GITHUB_HELM_REPOSITORY=homelab-helm
GITHUB_GITOPS_REPOSITORY=homelab-gitops
GITHUB_TARGET_BRANCH=main
